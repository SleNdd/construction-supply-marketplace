# Скопируйте в .env для Docker Compose и задайте собственные значения.
POSTGRES_DB=obektmarket
POSTGRES_USER=obektmarket
POSTGRES_PASSWORD=change-this-local-password
SESSION_SECRET=change-this-to-a-long-random-string

# Необязательные внешние сервисы. Без них работает обозначенный деморежим.
DADATA_API_KEY=
DADATA_SECRET_KEY=
GIS_MAP_KEY=
GIS_ROUTING_KEY=
